#include <iostream>
#include <cmath>
#include <string>
#include <stack>
#include <queue>
using namespace std;


int CountOccurrences(queue<int>&q,int key){
    queue<int>temp;
    int count=0;
    
    while(!q.empty()){
        if(q.front()==key){
            count++;
        }
        temp.push(q.front());
        q.pop();
    }
    while(!temp.empty()){
        q.push(temp.front());
        temp.pop();
    }
    return count;
}

void PrintQueue(queue<int>q){
    while(!q.empty()){
        cout << "| " << q.front() <<" |";
        q.pop();
    }
}

int main(){
 queue<int>q;
 
 q.push(3);
 q.push(7);
 q.push(7);
 q.push(7);
 q.push(4);
 q.push(9);

 int Count = CountOccurrences(q,7);
 PrintQueue(q);
 cout << "\n";
 cout <<"count occurences were: " << Count << " times \n";
 

 return 0;
}
