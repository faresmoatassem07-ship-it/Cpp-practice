#include <iostream>
#include <cmath>
#include <string>
#include <stack>
#include <queue>
using namespace std;

class Shape {
    protected:
    string Colour;
    
    public:
    Shape(){}
    Shape(string C){
        Colour=C;
    }
    virtual int Area()=0;
};

class Circle : public Shape {
    private:
    int Radius;
    
    public:
    Circle(int R,string Colour):Shape(Colour){
        Radius=R;
    }
    int Area() override{
        return 3.14*(pow(Radius,2));
    }
};

class Rectangle : public Shape {
    private:
    int Length;
    int Width;
    
    public:
    Rectangle(int L , int W , string Colour):Shape(Colour){
        Length=L;
        Width=W;
    }
    int Area() override {
        return Length*Width;
    }
};

void InsertionSort(Shape* arr[] , int size){
    for(int i =1 ; i<size ; i++){//outer loop to create the sorted, unsorted boundary and control passes
    Shape* key= arr[i]; // assume the first elemnt is sorted
    int j = i-1; //to compare with elements before our current
        while(j>=0 && arr[j]->Area() > key->Area()){//if elements before key are larger:
        arr[j+1]=arr[j]; //shift right
        j--; //keep looking left in sorted region for any other larger elements
        }
            arr[j+1]=key; //insert in correct position , whole objects not just variables
}
}


int main(){
 Shape* shapes[2];
 
 shapes[0]=new Rectangle(4,6,"blue");
 shapes[1]=new Circle(5,"red");
 
 InsertionSort(shapes,2);
 
 
 return 0;
}
