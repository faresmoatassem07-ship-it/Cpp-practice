#include <iostream>
#include <cmath>
#include <string>
#include <stack>
#include <queue>
using namespace std;

void interLeaveStack(stack<int>&s){
    stack<int>t1;
    stack<int>t2;
    int Fixedsize=s.size();
    
    //first half of elemets:
    for(int i=0 ; i<Fixedsize/2 ; i++){
        t1.push(s.top()); //place them in t1;
        s.pop();
    } // now only the other half is left in s so;
    
    while(!s.empty()){
        t2.push(s.top()); //2nd half of elements in t2
        s.pop();
    }
    
    while(!t1.empty()&&!t2.empty()){//run until both are empty to collect all our elements
        s.push(t2.top());
        t2.pop();
        s.push(t1.top());
        t1.pop();
        //the 4 previous lines basically mean to push once from each and pop the element after
    }
}


void PrintStack(stack<int>s){
    while(!s.empty()){
        cout<< s.top() <<endl;
        s.pop();
    }
}


int main() {
   stack<int>s;

    s.push(6);
    s.push(5);
    s.push(4);
    s.push(3);
    s.push(2);
    s.push(1);
    
    
    interLeaveStack(s);
    PrintStack(s);
   
  

    return 0;
}
